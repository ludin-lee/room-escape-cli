  "hints": [
    {
      "when": {
        "notFlag": "podium_checked"
      },
      "text": "교탁을 조사해 보세요."
    },
    {
      "when": {
        "notFlag": "note_seen"
      },
      "text": "쪽지를 주워서 읽어 보세요."
    },
    {
      "when": {
        "notFlag": "board_seen"
      },
      "text": "칠판에 오늘 날짜가 적혀 있습니다."
    },
    {
      "when": {
        "notSolved": "locker_lock"
      },
      "text": "오늘 날짜(월과 일)를 세 자리로 사물함에 입력하세요."
    },
    {
      "when": {
        "notSolved": "class_lock"
      },
      "text": "사물함 안의 열쇠를 줍고 문에 사용하세요."
    },
    {
      "when": {
        "notFlag": "bulletin_seen"
      },
      "text": "복도 게시판을 읽어 보세요."
    },
    {
      "when": {
        "notFlag": "plaque_seen"
      },
      "text": "복도의 명판에 개교 연도가 있습니다."
    },
    {
      "when": {
        "notSolved": "gate_lock"
      },
      "text": "개교 연도 네 자리를 키패드에 입력하세요."
    }
  ],
  "endings": {
    "success": "정문을 밀고 운동장으로 뛰어나갔다. 뒤에서 경비 아저씨가 \"야! 너 아직 있었냐!\" 하고 소리친다. 당신은 학교를 탈출했다.",
    "timeout": "복도 끝에서 철컥, 정문이 잠기는 소리가 들렸다. 오늘 밤은 교실에서 자야 할 것 같다."
  }
